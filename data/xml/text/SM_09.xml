    <raw-text role="processing">
      <sentence n="1">
        <kanji>天皇大命尓坐西奏賜久</kanji>
        <transcription>sumyera ga opo mikoto ni ima se mawosi tamapa ku</transcription>
      </sentence>
      <sentence n="2">
        <kanji>掛母畏岐</kanji>
        <transcription>kake maku mo kasikwo ki</transcription>
      </sentence>
      <sentence n="3">
        <kanji>飛鳥浄御原宮尓大八洲所知志</kanji>
        <transcription>asuka no kiywo mi bara no miya ni opo ya sima sira si myesi si</transcription>
      </sentence>
      <sentence n="4">
        <kanji>聖乃天皇命天下乎治賜比平賜比弖所思坐久</kanji>
        <transcription>piziri no sumyera mikoto ame no sita wo wosame tama pi tapirage tama pite omoposi masa ku</transcription>
      </sentence>
      <sentence n="5">
        <kanji>上下乎斉倍和気弖无動久</kanji>
        <transcription>kami simwo wo totono pe yapara gete ugwoki na ku</transcription>
      </sentence>
      <sentence n="6">
        <kanji>静加尓令有尓波礼等楽等二都並弖志平久</kanji>
        <transcription>sidu ka ni ara simuru ni pa rai to gaku to puta tu narabe te si tapirake ku</transcription>
      </sentence>
      <sentence n="7">
        <kanji>長久可有等</kanji>
        <transcription>naga ku aru be si to</transcription>
      </sentence>
      <sentence n="8">
        <kanji>随神母所思坐弖</kanji>
        <transcription>kamu nagara mo omoposi masi te</transcription>
      </sentence>
      <sentence n="9">
        <kanji>此乃舞乎始賜比</kanji>
        <transcription>ko no mapi wo pazime tama pi</transcription>
      </sentence>
      <sentence n="10">
        <kanji>造賜比伎等聞食弖</kanji>
        <transcription>tukuri tama pi ki to kiki tamape te</transcription>
      </sentence>
      <sentence n="11">
        <kanji>与天地共尓絶</kanji>
        <transcription>ame tuti to tomo ni tayuru</transcription>
      </sentence>
      <sentence n="12">
        <kanji>事無久</kanji>
        <transcription>koto na ku</transcription>
      </sentence>
      <sentence n="13">
        <kanji>弥継尓</kanji>
        <transcription>iya tugitugi ni</transcription>
      </sentence>
      <sentence n="14">
        <kanji>受賜波利行牟</kanji>
        <transcription>uke tama pari yuka mu</transcription>
      </sentence>
      <sentence n="15">
        <kanji>物等之弖</kanji>
        <transcription>mono to site</transcription>
      </sentence>
      <sentence n="16">
        <kanji>皇太子斯王尓学志頂令荷弖</kanji>
        <transcription>pi tugi no mi kwo ko no opo kimi ni narapa si itadaki mota sime te</transcription>
      </sentence>
      <sentence n="17">
        <kanji>我皇天皇大前尓貢</kanji>
        <transcription>wa ga opo kimi sumyera mikoto no opo mapye ni tatematuru</transcription>
      </sentence>
      <sentence n="18">
        <kanji>事乎奏</kanji>
        <transcription>koto wo mawosu</transcription>
      </sentence>
    </raw-text>
