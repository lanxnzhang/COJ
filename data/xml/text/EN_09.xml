      <sentence n="1">
        <kanji>櫛磐牖豐磐牖</kanji>
        <transcription>kusi ipamatwo toyoipamatwo no</transcription>
      </sentence>
      <sentence n="2">
        <kanji>命止</kanji>
        <transcription>mikoto to</transcription>
      </sentence>
      <sentence n="3">
        <kanji>御名乎申</kanji>
        <transcription>mi na wo mawosu</transcription>
      </sentence>
      <sentence n="4">
        <kanji>事波四方内外御門爾如湯津磐材久塞坐弖</kanji>
        <transcription>koto pa yo mo uti two no mi kadwo ni yutu ipa mura no goto ku sayari masi te</transcription>
      </sentence>
      <sentence n="5">
        <kanji>四方四角與利疎備荒備來武</kanji>
        <transcription>yo mo yo sumi ywori utwo bwi ara bwi ko mu</transcription>
      </sentence>
      <sentence n="6">
        <kanji>天乃麻我都比止云</kanji>
        <transcription>amenomagatupi to ipu</transcription>
      </sentence>
      <sentence n="7">
        <kanji>神乃言武</kanji>
        <transcription>kamwi no ipa mu</transcription>
      </sentence>
      <sentence n="8">
        <kanji>惡事爾古語云万可許登相麻自許利</kanji>
        <transcription>maga koto ni purugoto ni maga koto to ipu api mazikori</transcription>
      </sentence>
      <sentence n="9">
        <kanji>相口會賜</kanji>
        <transcription>api kuti ape tamapu</transcription>
      </sentence>
      <sentence n="10">
        <kanji>事无久</kanji>
        <transcription>koto na ku</transcription>
      </sentence>
      <sentence n="11">
        <kanji>自上往波</kanji>
        <transcription>upe ywori yuka ba</transcription>
      </sentence>
      <sentence n="12">
        <kanji>上護利</kanji>
        <transcription>upe wo mamo ri</transcription>
      </sentence>
      <sentence n="13">
        <kanji>自下往波</kanji>
        <transcription>sita ywori yuka ba</transcription>
      </sentence>
      <sentence n="14">
        <kanji>下護利待防掃却言排坐弖</kanji>
        <transcription>sita wo mamo ri moti pusegi parapi yari ipi soke masi te</transcription>
      </sentence>
      <sentence n="15">
        <kanji>朝波開門</kanji>
        <transcription>asita pa mi kadwo wo piraki</transcription>
      </sentence>
      <sentence n="16">
        <kanji>夕波閉門弖</kanji>
        <transcription>yupubye pa mikadwo wo tate te</transcription>
      </sentence>
      <sentence n="17">
        <kanji>參入罷出</kanji>
        <transcription>mawiri magaduru</transcription>
      </sentence>
      <sentence n="18">
        <kanji>人名乎問所知之</kanji>
        <transcription>pito no na wo twopi sira si</transcription>
      </sentence>
      <sentence n="19">
        <kanji>咎過在乎波神直備大直備爾見直聞直坐弖</kanji>
        <transcription>toga ayamati ara mu woba kamunapobi oponapobi ni mi naposi kiki naposi masi te</transcription>
      </sentence>
      <sentence n="20">
        <kanji>平久安久</kanji>
        <transcription>tapi rake ku yasu rake ku</transcription>
      </sentence>
      <sentence n="21">
        <kanji>令奉仕賜</kanji>
        <transcription>tukape matura sime tamapu ga</transcription>
      </sentence>
      <sentence n="22">
        <kanji>故爾</kanji>
        <transcription>yuwe ni</transcription>
      </sentence>
      <sentence n="23">
        <kanji>豐磐牖</kanji>
        <transcription>toyoipamatwo no</transcription>
      </sentence>
      <sentence n="24">
        <kanji>命櫛磐牖</kanji>
        <transcription>mikoto kusiipamatwo no</transcription>
      </sentence>
      <sentence n="25">
        <kanji>命止</kanji>
        <transcription>mikoto to</transcription>
      </sentence>
      <sentence n="26">
        <kanji>御名乎稱辭竟奉久止白</kanji>
        <transcription>mi na wo tatapegoto wope matura ku to mawosu</transcription>
      </sentence>
