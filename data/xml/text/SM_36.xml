        <transcription>ko no kurawi wo saduke matura mu to mawo saba</transcription>
      </sentence>
      <sentence n="3">
        <kanji>必不敢</kanji>
        <transcription>kanarazu apezi</transcription>
      </sentence>
      <sentence n="4">
        <kanji>伊奈等</kanji>
        <transcription>ina to</transcription>
      </sentence>
      <sentence n="5">
        <kanji>宣多方牟止</kanji>
        <transcription>nori taba mu to</transcription>
      </sentence>
      <sentence n="6">
        <kanji>念之天奈毛</kanji>
        <transcription>omopo site namo</transcription>
      </sentence>
      <sentence n="7">
        <kanji>不申之天</kanji>
        <transcription>mawosa zu site</transcription>
      </sentence>
      <sentence n="8">
        <kanji>是能太政大臣禅師乃御位授末都流等勅</kanji>
        <transcription>ko no dai zyau dai zin zen zi no mi kurawi saduke maturu to noritamapu</transcription>
      </sentence>
      <sentence n="9">
        <kanji>御命乎諸聞食等宣</kanji>
        <transcription>opo mikoto wo moro moro kiki tamapeyo to noritamapu</transcription>
      </sentence>
